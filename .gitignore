.venv/
.tmp-build/
.tmp-ui/
tmp/
# React/Vite frontend build tooling and its generated output. The build
# output is regenerated into src/aia_web/static/app/ by `npm run build`
# (see scripts/build-windows.ps1) and picked up by PyInstaller automatically.
frontend/node_modules/
frontend/dist/
src/aia_web/static/app/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/
*.egg-info/
.coverage
htmlcov/
evaluation/actual-codex/
evaluation/product-e2e-live/
evaluation/product-e2e/
# Actual Codex evaluation runs contain machine-specific paths and may contain
# sensitive agent output. Keep generated runs local unless they are reviewed
# and promoted as a sanitized validation fixture.
evaluation/product-before-after/actual-codex-*/
# Runtime and local secret artifacts must never become new source files.
*.env
*.env.*
*.jsonl
*.log
*.db
*.sqlite
*.sqlite3
*.pem
*.key
*.pfx
.aia/
.codex/
# Local QA renders and generated evaluation output are not source artifacts.
docs/generated/qa-*/
docs/generated/*.pdf
evaluation/product-before-after/eval-*/
evaluation/product-before-after/fixture-*/
